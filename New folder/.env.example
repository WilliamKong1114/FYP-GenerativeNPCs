# Example environment variables for local development
# Copy to .env and fill in real values. Do NOT commit the .env file.

# Path to Google service account JSON used by Vertex AI SDK / google libraries
GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\finalyearproject-xxxx.json

# Chroma DB path (persistent client directory)
CHROMA_DB_PATH=./chroma_db

# FastAPI / Uvicorn
FASTAPI_HOST=127.0.0.1
FASTAPI_PORT=8000

# Optional: other API keys you might use
OPENAI_API_KEY=
OTHER_API_KEY=
