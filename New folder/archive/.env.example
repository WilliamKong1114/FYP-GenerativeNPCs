# Copy this file to .env and fill in your actual values

# Google Custom Search API credentials
GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# Brave Search API (free tier: 2000 queries/month)
BRAVE_API_KEY=your_brave_api_key_here

# Bing Search API (free tier: 3000 queries/month)
BING_API_KEY=your_bing_api_key_here

# Example values:
# GOOGLE_API_KEY=AIzaSyDZRK7LrEyQNVm_Pv1iUxdm2R-bBO8JB7w
# GOOGLE_SEARCH_ENGINE_ID=a1b2c3d4e5f6g7h8i
# BRAVE_API_KEY=BSA_1234567890abcdef
# BING_API_KEY=1a2b3c4d5e6f7g8h9i0j